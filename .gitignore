# Dependencies — restorable from web/package-lock.json
web/node_modules/

# Generated image cache. The directory and its manifest are ignored together:
# imagepipe.py trusts the manifest's size:mtime fingerprints, so keeping the
# manifest without the files it describes would make the build skip work it
# still needs to do.
build/.imgcache/
build/.imagecache.json

# Python bytecode
__pycache__/
*.py[cod]

# Astro build output and cache (the app itself is tracked)
web/.astro/
web/dist/

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store

# NOTE: site/ and source-assets/ are deliberately NOT ignored.
# This repository exists as the rollback point for a migration that deletes
# both. source-assets/ holds irreplaceable originals; site/ is the parity
# oracle the migration is verified against, and cannot be reliably regenerated
# today because the generator's Python dependencies are undeclared
# (see docs/AUDIT.md section 4).
