# Node dependencies — restorable from package-lock.json
node_modules/

# React build output
dist/
.react-router/

# Python bytecode
__pycache__/
*.py[cod]

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store

# NOTE: source-assets/ is deliberately NOT ignored. It holds the irreplaceable
# originals — 577 images and 176 PDFs — that the published site was built from.
# docs/AUDIT.md section 16 lists it under "Never delete".
#
# The legacy static implementation (build/, site/, assets/, templates/, web/)
# was removed at S7. The pristine pre-migration baseline, including the
# generated site/ that served as the migration's parity oracle, remains on the
# `main` branch:
#
#     git checkout main
#
# The generator's pinned Python dependencies were Pillow==12.1.1 and
# fonttools==4.62.1 (verified in a clean venv on Python 3.14.3).
