---
/**
 * S2 proof route. Deliberately minimal: its job is to demonstrate that the
 * ported design system renders identically under Astro and that the output
 * is static HTML with zero JavaScript, before any island is introduced.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Home"
  description="An in-campus research institute of Dr. A.P.J. Abdul Kalam Technical University, Lucknow."
  canonicalPath="/"
>
  <div class="page-head container">
    <p class="eyebrow">Migration</p>
    <h1>Design system ported</h1>
    <p class="lede">
      This page is rendered by Astro using the same tokens, base and component
      stylesheets as the existing static build. It ships no JavaScript.
    </p>
  </div>

  <section class="section section--flush-top">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head__text">
          <p class="eyebrow">Primitives</p>
          <h2>Components render unchanged</h2>
        </div>
      </div>

      <div class="hero__actions" style="margin-bottom:var(--space-8)">
        <a class="btn btn--lg btn--primary" href="/">Primary action</a>
        <a class="btn btn--lg btn--secondary" href="/">Secondary</a>
        <a class="btn btn--lg btn--ghost" href="/">Ghost</a>
      </div>

      <ul class="record-list">
        <li class="record-row">
          <div class="record-row__title"><a href="/">A record row</a></div>
          <div class="record-row__meta">Type &middot; Area &middot; 2026</div>
          <span class="badge badge--open">Open</span>
        </li>
        <li class="record-row">
          <div class="record-row__title"><a href="/">Another record</a></div>
          <div class="record-row__meta">Pending confirmation</div>
          <span class="badge badge--draft">Planned</span>
        </li>
      </ul>

      <p class="hub-meta">
        Tokens, typography, spacing scale and the metric-matched font
        fallbacks all carried over verbatim &mdash; see
        docs/MIGRATION_ASTRO.md &sect;2.
      </p>
    </div>
  </section>
</BaseLayout>
