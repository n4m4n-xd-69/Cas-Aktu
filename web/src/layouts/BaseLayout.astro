---
/**
 * The single page shell. Ports templates/_layout.html.
 *
 * Two things here are load-bearing for the metrics the migration must not
 * lose, and both must stay inline in <head>:
 *   1. the theme script, which runs before first paint so there is no flash;
 *   2. the font preloads, which pair with the metric-matched fallbacks in
 *      tokens.css to hold CLS at 0.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

export interface Props {
  title: string;
  description: string;
  /** Canonical path in public (directory) form, e.g. "/academics/programs/". */
  canonicalPath?: string;
  bodyClass?: string;
}

const { title, description, canonicalPath, bodyClass = '' } = Astro.props;

// Canonical URLs keep the directory form the site is already indexed under,
// even though build.format:'file' emits about.html on disk.
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '/');
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | Centre for Advanced Studies</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Centre for Advanced Studies" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#292B88" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0B0C11" media="(prefers-color-scheme: dark)" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<!-- Self-hosted; only the latin subsets are preloaded, latin-ext arrives on
     demand via unicode-range. -->
<link rel="preload" as="font" type="font/woff2" crossorigin
      href="/assets/fonts/inter-latin.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin
      href="/assets/fonts/source-serif-4-latin.woff2" />

<script is:inline>
  /* Runs before first paint: correct theme with no flash. js-on marks that
     scripts run, so scroll-reveal may safely start hidden — without JS the
     class never lands and all content renders visible. */
  document.documentElement.classList.add('js-on');
  try {
    var t = localStorage.getItem('cas-theme');
    if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
</script>
</head>

<body class={bodyClass}>
<a class="skip-link" href="#main">Skip to main content</a>
<slot name="masthead" />
<main id="main">
  <slot />
</main>
<slot name="footer" />
</body>
</html>
